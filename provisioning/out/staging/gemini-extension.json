{
  "contextFileName": "GEMINI.md",
  "description": "Meridian AI usage & capability controls, scoped per caller.",
  "mcpServers": {
    "meridian-usage-staging": {
      "args": [
        "${MERIDIAN_REPO}/connector/dist/index.js"
      ],
      "command": "node",
      "cwd": "${MERIDIAN_REPO}/connector",
      "env": {
        "MERIDIAN_ACTOR": "priya.nair@meridianls.example",
        "MERIDIAN_DIRECTORY": "${MERIDIAN_REPO}/starter-kit/data/directory",
        "MERIDIAN_ENV": "staging",
        "MERIDIAN_MANIFEST": "${MERIDIAN_REPO}/provisioning/out/staging/permissions.json",
        "MERIDIAN_SERVICE_URL": "http://127.0.0.1:8000"
      }
    }
  },
  "name": "meridian-usage-staging",
  "version": "0.1.0"
}
